<AddIn name="Clarion Window Formatter" author="asantarelli" description="Formatea ventanas Clarion con IA (Claude API)">
  <Manifest>
    <Identity name="ClarionWindowFormatter" version="2.1.1"/>
  </Manifest>
  <Runtime>
    <Import assembly="ClarionWindowFormatter.dll"/>
  </Runtime>

  <Path name="/Workspace/Tools">
    <MenuItem id="WindowFormatterSeparator" type="Separator"/>
    <MenuItem id="FormatWindowWithAi"
              label="Formatear ventana con IA (Claude)..."
              class="ClarionWindowFormatter.Commands.FormatWindowWithAiCommand"/>
    <MenuItem id="FormatWindowSettings"
              label="Formatear ventana - Configuracion..."
              class="ClarionWindowFormatter.Commands.FormatWindowSettingsCommand"/>
  </Path>
</AddIn>
